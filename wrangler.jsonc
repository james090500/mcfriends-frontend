{
    "name": "mcfriends-frontend",
    "compatibility_date": "2026-04-23",
    "assets": {
        "directory": "./dist/",
        "not_found_handling": "single-page-application"
    },
    "routes": [
        {
            "pattern": "mcfriends.james090500.com",
            "custom_domain": true
        }
    ],
    "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true,
            "invocation_logs": true
        },
        "traces": {
            "enabled": true,
            "persist": true,
            "head_sampling_rate": 1
        }
    }
}
